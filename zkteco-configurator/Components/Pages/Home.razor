@using easy_core
@using zkteco_attendance_api
@using zkteco_configurator.Models

@page "/"
@inherits ComponentBase
@implements IDisposable

<TitleBlock Title="ZKTeco Configurator" >
    <div class="p-0 m-0 mt-1 is-pulled-right">
        @($"V{AppVersion}")
    </div>
</TitleBlock>

<Panel class="pt-2 px-2 mb-0 is-size-7" Title="Clock Settings">
    <EditForm Model="InputModel" OnValidSubmit="OnConnect">
        <DataAnnotationsValidator />

        <div class="columns is-variable is-1">
            <div class="column is-8-desktop is-8-widescreen is-9-fullhd is-10-4k">
                <div class="columns is-multiline is-variable is-1">
                    <div class="column is-12-desktop is-12-widescreen is-6-fullhd">
                        <div class="field">
                            <Label For="() => InputModel.IpAddress" TooltipMode="TooltipTop" />
                            <div class="control has-icons-left">
                                <InputText class="input" @bind-Value="InputModel.IpAddress" />
                                <span class="material-icons icon is-left">title</span>
                                <div class="help is-danger">
                                    <ValidationMessage For="() => InputModel.IpAddress" />
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <Label For="() => InputModel.Port" TooltipMode="TooltipTop" />
                            <div class="control has-icons-left">
                                <InputNumber class="input" @bind-Value="InputModel.Port" />
                                <span class="material-icons icon is-left">numbers</span>
                                <div class="help is-danger">
                                    <ValidationMessage For="() => InputModel.Port" />
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <Label For="() => InputModel.NickName" TooltipMode="TooltipTop" />
                            <div class="control has-icons-left">
                                <InputText class="input" @bind-Value="InputModel.NickName" />
                                <span class="material-icons icon is-left">label</span>
                                <div class="help is-danger">
                                    <ValidationMessage For="() => InputModel.NickName" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="column is-12-desktop is-12-widescreen is-6-fullhd">
                        <div class="field">
                            <Label For="() => InputModel.Password" TooltipMode="TooltipTop" />
                            <div class="control has-icons-left">
                                <InputPassword class="input" @bind-Value="InputModel.Password" />
                                <div class="help is-danger">
                                    <ValidationMessage For="() => InputModel.Password" />
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <Label For="() => InputModel.Description" TooltipMode="TooltipTop" />
                            <div class="control has-icons-left">
                                <InputText class="input" @bind-Value="InputModel.Description" />
                                <span class="material-icons icon is-left">description</span>
                                <div class="help is-danger">
                                    <ValidationMessage For="() => InputModel.Description" />
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            <Label TValue="object" DisplayText="Options" data-tooltip="Select the settings for the clock connection." TooltipMode="TooltipTop" />
                            <InputSwitch class='input' div-class="p-3" @bind-Value="InputModel.UseTcp" TooltipMode="TooltipTop" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="column is-4-desktop is-4-widescreen is-3-fullhd is-2-4k">
                <div class="field">
                    <Label TValue="object" DisplayText="Saved Devices" />
                    <Table class="is-fullwidth is-hoverable is-striped is-size-7">
                        <TableBody>
                            @foreach (var device in SavedDevices)
                            {
                                <tr>
                                    <td class='@(ZkTecoClock != null && ZkTecoClock.IsConnected ? "" : "is-clickable")' @onclick="() => LoadSavedDevice(device)">
                                        <strong>@(device.NickName ?? "Unnamed Device")</strong>
                                        <br />
                                        <span>@device.Ip:@device.Port</span>
                                        @if (string.IsNullOrWhiteSpace(device.Description) == false)
                                        {
                                            <br />
                                            <span class="is-italic">@device.Description</span>
                                        }
                                    </td>
                                    <td class="has-text-right">
                                        <button type="button" class="button is-small is-danger my-1" @onclick:stopPropagation="true" @onclick="() => DeleteSavedDevice(device)">
                                            <span class="material-icons icon">delete_forever</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </TableBody>
                    </Table>
                </div>

                <div class="field">
                    <Label TValue="object" DisplayText="Connection Status" />
                    <div class="control has-icons-left">
                        <InputTextArea class="input textarea is-info" @bind-Value="ConnectionStatusMessage" rows="12" readonly />
                        <span class="material-icons icon is-left">description</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="field is-grouped">
            <div class="control is-expanded">
                <SubmitButton class="is-fullwidth mb-4" disabled="@DisableSubmit" DisplayText="Connect" Icon="time_auto" />
            </div>
            <div class="control is-expanded">
                <button type="button" class="button is-danger is-fullwidth mb-4" disabled="@DisableControls" @onclick="OnDisconnect">
                    <span class="material-icons icon">link_off</span>
                    <span>Disconnect</span>
                </button>
            </div>
        </div>
    </EditForm>
</Panel>

<Panel class="pt-2 px-2 mb-0 is-size-7" Title="Import / Export">
    @if (BackupActionMessage != null)
    {
        <div class=@(BackupActionMessage.Success ? "auto-hide" : null)>
            <Message Title=@(BackupActionMessage.Success ? null : "Error") class=@BackupActionMessage.Class OnDeleteClicked="@(() => BackupActionMessage = null)">
                @BackupActionMessage?.Message
            </Message>
        </div>
    }
    <div class="field is-grouped">
        <div class="control is-expanded">
            <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='OpenBackupModalForExport'>
                <span class="material-icons icon">download</span>
                <span>Export</span>
            </button>
        </div>
        <div class="control is-expanded">
            <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='OpenBackupModalForImport'>
                <span class="material-icons icon">upload</span>
                <span>Import</span>
            </button>
        </div>
    </div>
</Panel>

<Panel class="pt-2 px-2 mb-0 is-size-7" Title="Device Details & Management">
    @if (DeviceActionMessage != null)
    {
        <div class=@(DeviceActionMessage.Success ? "auto-hide" : null)>
            <Message Title=@(DeviceActionMessage.Success ? null : "Error") class=@DeviceActionMessage.Class OnDeleteClicked="@(() => DeviceActionMessage = null)">
                @DeviceActionMessage?.Message
            </Message>
        </div>
    }
    <EditForm Model="DeviceDetailsPlaceholder">
            <div class="columns is-variable is-1">
                <div class="column is-4-desktop is-4-widescreen is-3-fullhd is-2-4k">
                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='GetDeviceDetails'>
                        <span class="material-icons icon">play_arrow</span>
                        <span>Get Device Details</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='EnableDevice'>
                        <span class="material-icons icon">enable</span>
                        <span>Enable Device</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='DisableDevice'>
                        <span class="material-icons icon">disabled_by_default</span>
                        <span>Disable Device</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='RestartDevice'>
                        <span class="material-icons icon">restart_alt</span>
                        <span>Restart Device</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='ShutdownDevice'>
                        <span class="material-icons icon">settings_power</span>
                        <span>Shutdown Device</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='ClearAndRefresh'>
                        <span class="material-icons icon">reset_wrench</span>
                        <span>Clear Errors and Refresh</span>
                    </button>

                    <hr class="my-4" />

                    <div class="field">
                        <Label For="() => InputModel.ClockTime" TooltipMode="TooltipTop" />
                        <div class="control has-icons-left has-icons-right">
                            <InputDateTime class='input' @bind-Value=InputModel.ClockTime Options="InputDateTimeMode" disabled="@DisableControls" />
                            <div class="help is-danger">
                                <ValidationMessage For="() => InputModel.ClockTime" />
                            </div>
                        </div>
                    </div>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='SetClockTime'>
                        <span class="material-icons icon">schedule</span>
                        <span>Set Device Time</span>
                    </button>

                    <hr class="my-4" />

                    <div class="field">
                        <Label For="() => InputModel.DisplayText" TooltipMode="TooltipTop" />
                        <div class="control has-icons-left">
                            <InputText class="input" @bind-Value="InputModel.DisplayText" disabled="@DisableControls" />
                            <span class="material-icons icon is-left">title</span>
                            <div class="help is-danger">
                                <ValidationMessage For="() => InputModel.DisplayText" />
                            </div>
                        </div>
                    </div>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='SetDisplayText'>
                        <span class="material-icons icon">title</span>
                        <span>Set Device Display Text</span>
                    </button>

                    <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='ClearDisplayText'>
                        <span class="material-icons icon">delete_forever</span>
                        <span>Clear Device Display Text</span>
                    </button>
                </div>

                <div class="column is-8-desktop is-8-widescreen is-9-fullhd is-10-4k">
                    @if (DeviceStorageCounts != null)
                    {
                        <Level class="has-text-centered">
                            <LevelItem Heading="User Count" Title='@DeviceStorageCounts.Users.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Attendance Count" Title='@DeviceStorageCounts.Records.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Fingerprint Count" Title='@DeviceStorageCounts.Fingers.ToString("N0")' style="width: 33.33333%" />
                        </Level>

                        <Level class="has-text-centered">
                            <LevelItem Heading="Remaining Users" Title='@DeviceStorageCounts.AvailableUsers.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Remaining Attendance Records" Title='@DeviceStorageCounts.AvailableRecords.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Remaining Fingerprints" Title='@DeviceStorageCounts.AvailableFingers.ToString("N0")' style="width: 33.33333%" />
                        </Level>

                        <Level class="has-text-centered">
                            <LevelItem Heading="Max Users" Title='@DeviceStorageCounts.MaximumUsers.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Max Attendance Records" Title='@DeviceStorageCounts.MaximumRecords.ToString("N0")' style="width: 33.33333%" />
                            <LevelItem Heading="Max Fingerprints" Title='@DeviceStorageCounts.MaximumFingers.ToString("N0")' style="width: 33.33333%" />
                        </Level>
                    }

                    <div class="field">
                        <Label TValue="object" DisplayText="Device Details" />
                        <div class="control has-icons-left">
                            <InputTextArea class="input textarea is-info is-fullwidth" @bind-Value="DeviceDetailsMessage" rows="12" readonly />
                            <span class="material-icons icon is-left">description</span>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
</Panel>

<Panel class="pt-2 px-2 mb-0 is-size-7" Title="User Management">
    @if (UserManagementActionMessage != null)
    {
        <div class=@(UserManagementActionMessage.Success ? "auto-hide" : null)>
            <Message Title=@(UserManagementActionMessage.Success ? null : "Error") class=@UserManagementActionMessage.Class OnDeleteClicked="@(() => UserManagementActionMessage = null)">
                @UserManagementActionMessage?.Message
            </Message>
        </div>
    }
    <div class="columns is-variable is-1">
        <div class="column is-4-desktop is-4-widescreen is-3-fullhd is-2-4k">
            <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='GetUsers'>
                <span class="material-icons icon">groups</span>
                <span>Get Users</span>
            </button>

            <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='OpenModalAddUser'>
                <span class="material-icons icon">person_add</span>
                <span>Add User</span>
            </button>

            <div class="field mt-2">
                <Label TValue="object" DisplayText="Filter by Name" />
                <div class="control has-icons-left">
                    <InputText class="input" @bind-Value="UserFilterName" disabled="@DisableControls" placeholder="Type a name..." />
                    <span class="material-icons icon is-left">search</span>
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="Filter by Privilege" />
                <div class="control has-icons-left has-icons-right">
                    <InputSelectObject class='is-fullwidth' @bind-Value=UserFilterPrivilege Items="Array.ConvertAll((Privilege[])Enum.GetValues<Privilege>(), x => (Privilege?)x)" DisplayValue='x => x.GetValueDisplayName()' NullText="All" disabled="@DisableControls" />
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="Filter by RFID Card" />
                <div class="control has-icons-left">
                    <InputNumber class="input" @bind-Value="UserFilterCard" disabled="@DisableControls" />
                    <span class="material-icons icon is-left">numbers</span>
                </div>
            </div>

            <button type="button" class="button is-light is-fullwidth my-1" disabled="@DisableControls" @onclick='ClearUserFilters'>
                <span class="material-icons icon">filter_alt_off</span>
                <span>Clear Filters</span>
            </button>
        </div>

        <div class="column is-8-desktop is-8-widescreen is-9-fullhd is-10-4k">
            <Table class="is-fullwidth is-hoverable is-striped is-size-6">
                <TableHead>
                    <tr>
                        <th>User Id</th>
                        <th>Name</th>
                        <th>Password</th>
                        <th>Privilege</th>
                        <th>Group</th>
                        <th>Card</th>
                        <th>&nbsp;</th>
                        <th>&nbsp;</th>
                    </tr>
                </TableHead>
                <TableBody>
                    @foreach (var user in FilteredUsers)
                    {
                        <tr @key="user.UserId">
                            <TableData>@user.UserId</TableData>
                            <TableData>@user.Name</TableData>
                            <TableData class="is-masked" tabindex="0">@user.Password</TableData>
                            <TableData>@user.Privilege.GetValueDisplayName()</TableData>
                            <TableData>@user.Group</TableData>
                            <TableData>@user.Card</TableData>
                            <td>
                                <button type="button" class="button is-small is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='() => EditUser(user)'>
                                    <span class="material-icons icon">edit</span>
                                    <span>Edit</span>
                                </button>
                            </td>
                            <td>
                                <button type="button" class="button is-small is-danger is-fullwidth my-1" disabled="@DisableControls" @onclick='() => DeleteUser(user)'>
                                    <span class="material-icons icon">delete_forever</span>
                                    <span>Delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                </TableBody>
            </Table>
        </div>
    </div>
</Panel>

<Panel class="pt-2 px-2 mb-0 is-size-7" Title="Attendance Management">
    @if (AttendanceActionMessage != null)
    {
        <div class=@(AttendanceActionMessage.Success ? "auto-hide" : null)>
            <Message Title=@(AttendanceActionMessage.Success ? null : "Error") class=@AttendanceActionMessage.Class OnDeleteClicked="@(() => AttendanceActionMessage = null)">
                @AttendanceActionMessage?.Message
            </Message>
        </div>
    }
    <div class="columns is-variable is-1">
        <div class="column is-4-desktop is-4-widescreen is-3-fullhd is-2-4k">
            <button type="button" class="button is-info is-fullwidth my-1" disabled="@DisableControls" @onclick='GetAttendanceRecords'>
                <span class="material-icons icon">event_note</span>
                <span>Get Attendance</span>
            </button>

            <button type="button" class="button is-danger is-fullwidth my-1" disabled="@DisableControls" @onclick='OpenDeleteAttendanceModal'>
                <span class="material-icons icon">delete_forever</span>
                <span>Delete Attendance</span>
            </button>
        </div>

        <div class="column is-8-desktop is-8-widescreen is-9-fullhd is-10-4k">
            <Table class="is-fullwidth is-hoverable is-striped is-size-6">
                <TableHead>
                    <tr>
                        <th>User Id</th>
                        <th>Name</th>
                        <th>Card</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Punch</th>
                    </tr>
                </TableHead>
                <TableBody>
                    @foreach (var record in Attendances)
                    {
                        <tr>
                            <TableData>@record.UserId</TableData>
                            <TableData>@record.UserName</TableData>
                            <TableData>@(record.UserCard?.ToString() ?? "-")</TableData>
                            <TableData>@record.Timestamp.ToString("G")</TableData>
                            <TableData>@record.Status.ToString()</TableData>
                            <TableData>@record.Punch.ToString()</TableData>
                        </tr>
                    }
                </TableBody>
            </Table>
        </div>
    </div>
</Panel>

<Modal Title=@($"Device Backup {BackupModalMode.ToString()}") @bind-IsDisplayed=ModalBackupDisplayed foot-class="is-justify-content-center">
    <ModalBody>
        @if (BackupModalActionMessage != null)
        {
            <div class=@(BackupModalActionMessage.Success ? "auto-hide" : null)>
                <Message Title=@(BackupModalActionMessage.Success ? null : "Error") class=@BackupModalActionMessage.Class OnDeleteClicked="@(() => BackupModalActionMessage = null)">
                    @BackupModalActionMessage?.Message
                </Message>
            </div>
        }

        <label class="label">Choose what to include in the @(BackupModalMode.ToString().ToLowerInvariant()):</label>

        @if (BackupModalMode == BackupOperationMode.Export)
        {
            <div class="field mb-2">
                <InputSwitch @bind-Value="BackupIncludeSettings" TooltipMode="BackupTooltipDisplayMode" IsBoxed="false" />
            </div>

            <div class="field mb-2 ml-5">
                <InputSwitch @bind-Value="BackupIncludeNetworkSettings" disabled="@(BackupIncludeSettings == false)" TooltipMode="BackupTooltipDisplayMode" IsBoxed="false" />
            </div>
        }

        <div class="field mb-2">
            <InputSwitch @bind-Value="BackupIncludeUsers" TooltipMode="BackupTooltipDisplayMode" IsBoxed="false" />
        </div>

        @if (BackupModalMode == BackupOperationMode.Export)
        {
            <div class="field mb-2">
                <InputSwitch @bind-Value="BackupIncludeAttendance" TooltipMode="BackupTooltipDisplayMode" IsBoxed="false" />
            </div>
        }

        @if (DisableBackup)
        {
            <p class="help is-danger">Select at least one section to @(BackupModalMode.ToString().ToLowerInvariant()).</p>
        }

        @if (BackupModalMode == BackupOperationMode.Import)
        {
            <div class="field mb-2">
                <button type="button" class="button is-info" disabled="@DisableControls" @onclick='SelectBackupFileAsync'>
                    <span class="material-icons icon">folder_open</span>
                    <span>Select Backup File</span>
                </button>
            </div>

            @if (BackupLoadedPackage != null)
            {
                <div class="content">
                    <p><strong>File:</strong> @BackupSelectedFileName</p>
                    <p><strong>Created:</strong> @BackupLoadedPackage.CreatedAtUtc.ToLocalTime()</p>
                    <p><strong>Source Device:</strong>
                        Serial: @(BackupLoadedPackage.DeviceInfo.SerialNumber ?? "unknown"),
                        Firmware: @(BackupLoadedPackage.DeviceInfo.FirmwareVersion ?? "unknown"),
                        Platform: @(BackupLoadedPackage.DeviceInfo.Platform ?? "unknown")
                    </p>
                </div>
            }
        }
    </ModalBody>
    <ModalFooter>
        <button type="button" class="button" @onclick='CloseBackupModal'>Cancel</button>

        @if (BackupModalMode == BackupOperationMode.Export)
        {
            <button type="button" class="button is-info" disabled="@(DisableControls || DisableBackup)" @onclick='ExportDeviceBackupAsync'>
                <span class="material-icons icon">download</span>
                <span>Export</span>
            </button>
        }
        else
        {
            <button type="button" class="button is-info" disabled="@(DisableControls || DisableBackup || BackupLoadedPackage == null)" @onclick='OpenConfirmImportModal'>
                <span class="material-icons icon">upload</span>
                <span>Import</span>
            </button>
        }
    </ModalFooter>
</Modal>

<Modal Title="Confirm Import" @bind-IsDisplayed=ModalConfirmImportDisplayed foot-class="is-justify-content-center">
    <ModalBody>
        <p>Importing will write the selected backup data to the connected ZKTeco device. This action cannot be undone.</p>
        <p>Are you sure you want to continue?</p>
    </ModalBody>
    <ModalFooter>
        <button type="button" class="button" @onclick='CloseConfirmImportModal'>Cancel</button>
        <button type="button" class="button is-danger" @onclick='ImportDeviceBackupAsync'>
            <span class="material-icons icon">upload</span>
            <span>Confirm Import</span>
        </button>
    </ModalFooter>
</Modal>

<Modal Title="@(NewUser.Index == 0 ? "Create User" : "Update User")" @bind-IsDisplayed=ModalAddUserDisplayed foot-class="is-justify-content-center">
    <ModalBody>
        <EditForm Model="NewUser">
            <DataAnnotationsValidator />

            @if (UserModalActionMessage != null)
            {
                <div class=@(UserModalActionMessage.Success ? "auto-hide" : null)>
                    <Message Title=@(UserModalActionMessage.Success ? null : "Error") class=@UserModalActionMessage.Class OnDeleteClicked="@(() => UserModalActionMessage = null)">
                        @UserModalActionMessage?.Message
                    </Message>
                </div>
            }

            <div class="field">
                <Label TValue="object" DisplayText="Name" />
                <div class="control has-icons-left">
                    <InputText class="input" @bind-Value="NewUser.Name" disabled="@DisableControls" />
                    <span class="material-icons icon is-left">title</span>
                    <div class="help is-danger">
                        <ValidationMessage For="() => NewUser.Name" />
                    </div>
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="Password" />
                <div class="control has-icons-left">
                    <InputPassword class="input" @bind-Value="NewUser.Password" disabled="@DisableControls" />
                    <div class="help is-danger">
                        <ValidationMessage For="() => NewUser.Password" />
                    </div>
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="Privilege" />
                <div class="control has-icons-left has-icons-right">
                    <InputSelectObject class='is-fullwidth' @bind-Value=NewUser.Privilege Items="Enum.GetValues<Privilege>().ToList()" DisplayValue="x => x.GetValueDisplayName()" disabled="@DisableControls" />
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="Group" />
                <div class="control has-icons-left">
                    <InputText class="input" @bind-Value="NewUser.Group" disabled="@DisableControls" />
                    <span class="material-icons icon is-left">title</span>
                    <div class="help is-danger">
                        <ValidationMessage For="() => NewUser.Group" />
                    </div>
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="User Id" />
                <div class="control has-icons-left">
                    <InputText class="input" @bind-Value="NewUser.UserId" disabled="@DisableControls" />
                    <span class="material-icons icon is-left">title</span>
                    <div class="help is-danger">
                        <ValidationMessage For="() => NewUser.UserId" />
                    </div>
                </div>
            </div>

            <div class="field">
                <Label TValue="object" DisplayText="RFID Card" />
                <div class="control has-icons-left">
                    <InputNumber class="input" @bind-Value="NewUser.Card" disabled="@DisableControls" />
                    <span class="material-icons icon is-left">numbers</span>
                    <div class="help is-danger">
                        <ValidationMessage For="() => NewUser.Card" />
                    </div>
                </div>
            </div>
        </EditForm>
    </ModalBody>
    <ModalFooter>
        <button type="button" class="button" @onclick='CloseModalAddUser'>Cancel</button>

        <button type="button" class="button is-info" disabled="@DisableCreateUser" @onclick='CreateUser'>
            <span class="material-icons icon">@(NewUser.Index == 0 ? "person_add" : "update")</span>
            <span>
                @if (NewUser.Index == 0)
                {
                    @:Create User
                }
                else
                {
                    @:Update User
                }
            </span>
        </button>
    </ModalFooter>
</Modal>

<Modal Title="Confirm Attendance Deletion" @bind-IsDisplayed=ModalDeleteAttendanceDisplayed foot-class="is-justify-content-center">
    <ModalBody>
        <p class="is-size-6">This will permanently delete all attendance records on the device.<br />Continue?</p>
    </ModalBody>
    <ModalFooter>
        <button type="button" class="button" @onclick='CloseDeleteAttendanceModal'>Cancel</button>
        <button type="button" class="button is-danger" @onclick='ConfirmClearAttendanceRecords'>Delete</button>
    </ModalFooter>
</Modal>
